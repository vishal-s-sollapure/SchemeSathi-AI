# SchemeSathi AI — Backend Production Environment Variables

# Application Identity
PROJECT_NAME="SchemeSathi AI"
VERSION="0.1.0"
ENVIRONMENT="production" # "development" or "production"
DEBUG=False

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# Local SQLite default:
DATABASE_URL="sqlite:///./schemesathi.db"
# Render / Supabase / Neon PostgreSQL production:
# DATABASE_URL="postgresql://user:password@hostname:5432/schemesathi_db"

# CORS Configuration (comma-separated allowed origins)
BACKEND_CORS_ORIGINS="https://schemesathi-ai.vercel.app,http://localhost:5173,http://localhost:3000"

# File Upload & Document Intelligence Limits
MAX_UPLOAD_SIZE_BYTES=15728640  # 15 MB in bytes
UPLOAD_DIR="app/uploads"

# Regional Multilingual Configuration
DEFAULT_LANGUAGE="en"
SUPPORTED_LANGUAGES="en,kn,hi"

# Optional External Generative AI API (Falls back cleanly to local deterministic grounded synthesis if omitted)
# GEMINI_API_KEY="your-gemini-api-key-here"
LLM_PROVIDER="auto"  # "auto", "gemini", or "grounded_engine"
LLM_MODEL="gemini-1.5-flash"
